---
import '@/styles/tokens.css';
import '@/styles/base.css';
import { DEFAULT_LOCALE, alternates, dirFor, isLocale, t, type Locale } from '@/i18n';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const dir = dirFor(locale);
const strings = t(locale);
const { title, description = strings.meta.description, noindex = false, ogImage } = Astro.props;

// Absolute URLs come from the REQUEST origin, so one build serves the real
// domain and the workers.dev preview with correct canonicals and share cards.
const site = new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const alts = alternates(Astro.url.pathname, site);
const xDefault = alts.find((a) => a.hreflang === DEFAULT_LOCALE)?.href;
const og = ogImage ?? new URL(locale === 'en' ? '/og-image-en.png' : '/og-image.png', site).toString();
const ogAlt = locale === 'ur' ? `${strings.meta.siteName} — ${strings.strip.tagline}` : `${strings.meta.siteNameLatin} — ${strings.strip.tagline}`;

const fonts =
  locale === 'ur'
    ? ['/fonts/noto-naskh-arabic-arabic.woff2', '/fonts/noto-nastaliq-urdu-arabic.woff2', '/fonts/ibm-plex-sans-latin.woff2']
    : ['/fonts/source-serif-4-latin.woff2', '/fonts/ibm-plex-sans-latin.woff2'];
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#a8161e" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical.toString()} />
    {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.meta.siteNameLatin} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={locale === 'ur' ? 'ur_PK' : 'en_PK'} />
    <meta property="og:locale:alternate" content={locale === 'ur' ? 'en_PK' : 'ur_PK'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {/* .ico (16/32/48) for Google results and older browsers; SVG for the rest. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}

    {/* Reader text-size: apply the saved step before first paint. The stored
        value is untrusted — only the three known steps ever reach the DOM. */}
    <script is:inline>
      try {
        var s = localStorage.getItem('am-reader-scale');
        if (s === 'sm' || s === 'lg' || s === 'xl') document.documentElement.dataset.readerScale = s;
      } catch (e) {}
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.a11y.skip}</a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <slot name="after" />
  </body>
</html>
