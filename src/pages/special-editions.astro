---
import SpecialEditionsPage from '@/components/SpecialEditionsPage.astro';
import { resolveSpecials } from '@/lib/services/special';

const result = await resolveSpecials(Astro.url.searchParams, 'ur');
if (!result) return Astro.rewrite('/404');
---

<SpecialEditionsPage locale="ur" result={result} />
