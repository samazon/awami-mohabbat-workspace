---
import StubPage from '@/components/StubPage.astro';

// Sections that are in the nav but not built yet: each renders the under-construction page.
const SECTIONS = ['columns', 'gallery', 'media-forum', 'magazine', 'articles', 'search'] as const;
type Section = (typeof SECTIONS)[number];
const isSection = (v: unknown): v is Section => (SECTIONS as readonly string[]).includes(v as string);

const { section } = Astro.params;
if (!isSection(section)) return Astro.rewrite('/404');
---

<StubPage locale="ur" section={section} />
