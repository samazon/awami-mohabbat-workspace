---
import EditionPage from '@/components/EditionPage.astro';
import { getEditionByDate } from '@/lib/services/editions';

const { date = '' } = Astro.params;
if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return Astro.rewrite('/en/404');
const edition = await getEditionByDate(date, 'en');
if (!edition) return Astro.rewrite('/en/404');
---

<EditionPage locale="en" edition={edition} />
