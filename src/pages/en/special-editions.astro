---
import SpecialEditionsPage from '@/components/SpecialEditionsPage.astro';
import { resolveSpecials } from '@/lib/services/special';

const result = await resolveSpecials(Astro.url.searchParams, 'en');
if (!result) return Astro.rewrite('/en/404');
---

<SpecialEditionsPage locale="en" result={result} />
