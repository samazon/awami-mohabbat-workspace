---
import MagazineIssuePage from '@/components/MagazineIssuePage.astro';
import { getMagazineIssue } from '@/lib/services/magazine';

const issue = await getMagazineIssue(Astro.params.month ?? '', 'en');
if (!issue) return Astro.rewrite('/en/404');
---

<MagazineIssuePage locale="en" issue={issue} />
