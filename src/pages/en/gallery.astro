---
import { englishNotFound } from '@/lib/not-found';
import GalleryPage from '@/components/GalleryPage.astro';
import { resolveGallery } from '@/lib/services/gallery';

const result = await resolveGallery(Astro.url.searchParams, 'en');
if (!result) return englishNotFound(Astro);
---

<GalleryPage locale="en" result={result} />
