---
/**
 * /admin/team/<id>/card: a team member's press card, front and back, at the
 * CR80 card size (54 × 85.6 mm, portrait).
 *
 * Name, Urdu name, designation and photo come from the profile. CNIC, station,
 * address, card number and expiry are the card's own details: saved per member
 * in team_press_cards (admin only, never read by the public site). The QR on
 * the front opens /verify/<token>, a public page that confirms the card. "Download
 * PDF" renders both sides in the browser into a two-page CR80 PDF; "Print"
 * does the same through the print dialog.
 */
import { actions, isInputError } from 'astro:actions';
import AdminLayout from '@/layouts/AdminLayout.astro';
import Icon from '@/components/Icon.astro';
import paishani from '@/assets/paishani.webp';
import { pressCard as fixed } from '@/content/press-card';
import { globe } from '@/content/press-card-globe';
import { photoUrl } from '@/lib/services/team';
import { adminGetMember, adminGetPressCard } from '@/lib/services/team-admin';
import { suggestCardNo } from '@/lib/team/press-card';
import { renderSVG } from 'uqr';

const param = Astro.params.id ?? '';
if (!/^[1-9]\d{0,8}$/.test(param)) return new Response('Not found', { status: 404 });
const member = await adminGetMember(Number(param));
if (!member) return new Response('Not found', { status: 404 });

const result = Astro.getActionResult(actions.admin.pressCardSave);
if (result && !result.error) return Astro.redirect(`/admin/team/${member.id}/card?saved=1`);
const error = result?.error ?? null;
const saved = Astro.url.searchParams.get('saved') === '1';
const typed = (result?.error as { inputValue?: Record<string, unknown> } | undefined)?.inputValue ?? null;

const card = await adminGetPressCard(member.id);
const year = new Date().getFullYear();
const defaults = {
  cnic: card?.cnic ?? '',
  station: card?.station ?? member.placeEn ?? '',
  address: card?.address ?? '',
  cardNo: card?.cardNo ?? suggestCardNo(member.id, year),
  validUntil: card?.validUntil ?? `${year}-12-31`,
};
const val = (k: keyof typeof defaults) => (typed && typeof typed[k] === 'string' ? (typed[k] as string) : defaults[k]);
const fmtDate = (iso: string) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
  return m ? `${m[3]}/${m[2]}/${m[1]}` : '';
};
const photo = photoUrl(member);
// Printed cards must point at the real domain, whatever host served this page.
const origin = import.meta.env.DEV ? Astro.url.origin : (Astro.site?.origin ?? Astro.url.origin);
const verifyUrl = card?.verifyToken ? `${origin}/verify/${card.verifyToken}` : null;
// Our own SVG from a URL we built (token is validated on write); nothing typed here reaches it.
const qrSvg = verifyUrl ? renderSVG(verifyUrl, { ecc: 'M', border: 0, blackColor: '#1a1a1a', whiteColor: '#ffffff' }) : null;
// Lucide outlines, inlined: the site's <Icon> uses a sprite (<use href="#ai:…">) that the PDF renderer can't resolve.
const ICON = {
  pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
} as const;
const icon = (k: keyof typeof ICON) =>
  `<svg class="pc__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[k]}</svg>`;

---

<AdminLayout title={`Press card — ${member.nameEn}`} section="team">
  <div class="screen-only">
    <a class="back" href={`/admin/team/${member.id}`}><Icon name="arrow-left" size="sm" flip={false} /> {member.nameEn}</a>
    <div class="a-page-head">
      <h1 class="a-title">Press card</h1>
      <div class="head-actions">
        <span class="a-hint" data-status role="status"></span>
        <button class="a-btn a-btn--ghost" type="button" data-print><Icon name="printer" size="sm" /> Print</button>
        <button class="a-btn" type="button" data-download data-name={member.nameEn}><Icon name="download" size="sm" /> Download PDF</button>
      </div>
    </div>

    {error && (
      <p class="a-alert a-alert--bad" role="alert">
        <Icon name="triangle-alert" size="sm" />
        {isInputError(error) ? 'Some fields need attention.' : error.message}
      </p>
    )}
    {saved && !error && (
      <p class="a-alert" role="status" data-saved-alert><Icon name="check" size="sm" /> Card details saved.</p>
    )}
  </div>

  <div class="layout">
    <form class="a-card panel screen-only" method="POST" action={actions.admin.pressCardSave} aria-labelledby="card-details" data-card-form>
      <input type="hidden" name="id" value={member.id} />
      <h2 class="panel__title" id="card-details">Card details</h2>
      <div class="grid2">
        <div>
          <label class="a-label" for="pc-station">Station</label>
          <input class="a-input" id="pc-station" name="station" maxlength="60" value={val('station')} placeholder="e.g. Lahore" autocomplete="off" data-field="station" />
        </div>
        <div>
          <label class="a-label" for="pc-cnic">CNIC</label>
          <input class="a-input" id="pc-cnic" name="cnic" maxlength="15" value={val('cnic')} placeholder="35401-1234567-1" pattern="\d{5}-\d{7}-\d" inputmode="numeric" autocomplete="off" spellcheck="false" data-field="cnic" />
        </div>
        <div class="wide">
          <label class="a-label" for="pc-address">Address</label>
          <input class="a-input" id="pc-address" name="address" maxlength="160" value={val('address')} autocomplete="off" data-field="address" />
        </div>
        <div>
          <label class="a-label" for="pc-cardNo">Card no.</label>
          <input class="a-input" id="pc-cardNo" name="cardNo" maxlength="12" value={val('cardNo')} pattern="[A-Za-z0-9/-]+" autocomplete="off" spellcheck="false" data-field="cardNo" />
        </div>
        <div>
          <label class="a-label" for="pc-valid">Valid until</label>
          <input class="a-input" id="pc-valid" name="validUntil" type="date" value={val('validUntil')} data-valid />
        </div>
      </div>
      <div class="panel__actions">
        <button class="a-btn" type="submit"><Icon name="check" size="sm" /> Save details</button>
        <span class="a-hint" data-dirty hidden>Changes not saved yet.</span>
      </div>
      <p class="a-hint">
        Saved with this person, so the card can be printed again later. Name, Urdu name, designation and photo come from the profile — change them there.
      </p>
      {verifyUrl ? (
        <p class="a-hint">The QR code opens <a href={verifyUrl} target="_blank" rel="noopener">{verifyUrl.replace(/^https?:\/\//, '')}</a>, which confirms this card is genuine and in date. It shows only what the card front shows.</p>
      ) : (
        <p class="a-hint">Save once and the card gets its QR code: a verification link unique to this person.</p>
      )}
      <p class="a-hint">“Download PDF” gives a two-page file — front, then back — each page exactly 85.6 × 54 mm (CR80), ready for a card printer.</p>
    </form>

    <div class="cards" aria-label="Card preview">
      {/* ---------- front ---------- */}
      <article class="pc pc--front" aria-label="Front">
        <div class="pc__spine" aria-hidden="true">
          <span class="pc__hole"></span>
          <span class="pc__press">PRESS</span>
          <span class="pc__country">PAKISTAN MEDIA</span>
        </div>
        <div class="pc__body">
          <div class="pc__globe" set:html={globe} />
          <img class="pc__paishani" src={paishani.src} width={paishani.width} height={paishani.height} alt="Awami Mohabbat" />
          <p class="pc__dateline">{fixed.dateline}</p>
          <div class="pc__photo">
            {photo ? <img src={photo} alt="" /> : <span>Photo</span>}
          </div>
          <p class="pc__name">{member.nameEn}</p>
          <p class="pc__name-ur" lang="ur" dir="rtl">{member.nameUr}</p>
          <p class="pc__role">{member.roleEn ?? ''}</p>
          <div class="pc__foot">
            <div>
              <p class="pc__k">CARD NO.</p>
              <p class="pc__no" data-out="cardNo">{val('cardNo')}</p>
            </div>
            <div class="pc__qr">
              {qrSvg ? <div class="pc__qr-code"><div class="pc__qr-svg" set:html={qrSvg} /></div> : <div class="pc__qr-code pc__qr-code--empty"><span>Save to create</span></div>}
              <p class="pc__k">SCAN TO VERIFY</p>
            </div>
          </div>
        </div>
      </article>

      {/* ---------- back ---------- */}
      <article class="pc pc--back" aria-label="Back">
        <header class="pc__head">
          <span class="pc__press-h">PRESS</span>
          <span class="pc__motto">{fixed.motto}</span>
        </header>
        <dl class="pc__rows">
          <div><dt>CNIC</dt><dd data-out="cnic">{val('cnic')}</dd></div>
          <div><dt>STATION</dt><dd data-out="station">{val('station')}</dd></div>
          <div><dt>ADDRESS</dt><dd data-out="address">{val('address')}</dd></div>
        </dl>
        <p class="pc__note">{fixed.note}</p>
        <div class="pc__contact">
          <p class="pc__ci"><Fragment set:html={icon('pin')} /><span>{fixed.contact.map((l, i) => <>{i > 0 && <br />}{l}</>)}</span></p>
          <p class="pc__ci pc__ci--row">{fixed.phones.map((n) => <span class="pc__ci"><Fragment set:html={icon('phone')} /><span class="pc__mono">{n}</span></span>)}</p>
          <p class="pc__ci pc__ci--row">
            <span class="pc__ci"><Fragment set:html={icon('mail')} /><span>{fixed.email}</span></span>
            <span class="pc__ci"><Fragment set:html={icon('globe')} /><span>{fixed.website}</span></span>
          </p>
        </div>
        <footer class="pc__bar">
          <span>PAKISTAN MEDIA</span>
          <span>Valid until <strong data-out="valid">{fmtDate(val('validUntil'))}</strong></span>
        </footer>
      </article>
    </div>
  </div>
</AdminLayout>

<script>
  // Mirror the form into the card as you type. textContent only — typed text is never parsed as HTML.
  const outs = (key: string) => document.querySelectorAll<HTMLElement>(`[data-out="${key}"]`);
  const form = document.querySelector<HTMLFormElement>('[data-card-form]');
  const dirty = document.querySelector<HTMLElement>('[data-dirty]');
  const initial = new Map<HTMLInputElement, string>();
  const markDirty = () => {
    const changed = [...initial].some(([el, v]) => el.value !== v);
    if (dirty) dirty.hidden = !changed;
  };
  document.querySelectorAll<HTMLInputElement>('input[data-field]').forEach((input) => {
    initial.set(input, input.value);
    input.addEventListener('input', () => {
      outs(input.dataset.field!).forEach((el) => (el.textContent = input.value.trim()));
      markDirty();
    });
  });
  const valid = document.querySelector<HTMLInputElement>('input[data-valid]');
  if (valid) {
    initial.set(valid, valid.value);
    valid.addEventListener('input', () => {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(valid.value);
      outs('valid').forEach((el) => (el.textContent = m ? `${m[3]}/${m[2]}/${m[1]}` : ''));
      markDirty();
    });
  }
  // Leaving with unsaved edits? The browser asks first.
  window.addEventListener('beforeunload', (e) => {
    if (dirty && !dirty.hidden) e.preventDefault();
  });
  form?.addEventListener('submit', () => {
    if (dirty) dirty.hidden = true;
  });

  // The "saved" note fades after a few seconds, and the ?saved=1 is dropped so a reload doesn't repeat it.
  const savedAlert = document.querySelector<HTMLElement>('[data-saved-alert]');
  if (savedAlert) {
    history.replaceState(null, '', location.pathname);
    setTimeout(() => {
      savedAlert.classList.add('is-leaving');
      savedAlert.addEventListener('transitionend', () => savedAlert.remove(), { once: true });
    }, 3500);
  }

  document.querySelector('[data-print]')?.addEventListener('click', async () => {
    await document.fonts.ready; // print only once the card's fonts are in
    window.print();
  });

  /**
   * CR80 PDF, made entirely in the browser: each side is rendered at 600 dpi
   * and placed on its own 54 × 85.6 mm page. The libraries load only when asked for.
   */
  const CARD_W_MM = 54;
  const CARD_H_MM = 85.6;
  const DPI = 600;
  const download = document.querySelector<HTMLButtonElement>('[data-download]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  download?.addEventListener('click', async () => {
    if (download.disabled) return;
    download.disabled = true;
    if (status) status.textContent = 'Preparing PDF…';
    try {
      const [{ domToCanvas }, { jsPDF }] = await Promise.all([import('modern-screenshot'), import('jspdf')]);
      await document.fonts.ready;
      const sides = [...document.querySelectorAll<HTMLElement>('.pc')];
      const cardNo = document.querySelector<HTMLInputElement>('[data-field="cardNo"]')?.value.trim() ?? '';
      const title = `press-card-${cardNo}-${download.dataset.name ?? ''}`;
      const pdf = new jsPDF({ unit: 'mm', format: [CARD_W_MM, CARD_H_MM], orientation: 'portrait', compress: true });
      pdf.setProperties({ title, creator: 'Awami Mohabbat admin' });
      for (const [i, side] of sides.entries()) {
        // Layout size (offset* ignore the preview's CSS zoom; the bounding rect doesn't).
        const cssW = side.offsetWidth;
        const canvas = await domToCanvas(side, {
          width: cssW,
          height: side.offsetHeight,
          scale: (CARD_W_MM / 25.4) * DPI / cssW,
          backgroundColor: '#ffffff',
          // Full bleed: square corners, no preview shadow.
          style: { borderRadius: '0', boxShadow: 'none', zoom: '1' },
        });
        if (i > 0) pdf.addPage([CARD_W_MM, CARD_H_MM], 'portrait');
        pdf.addImage(canvas, 'PNG', 0, 0, CARD_W_MM, CARD_H_MM, undefined, 'FAST');
      }
      const name = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      pdf.save(`${name || 'press-card'}.pdf`);
      if (status) status.textContent = '';
    } catch (err) {
      console.error('press card pdf failed', err);
      if (status) status.textContent = 'The PDF could not be made. Try again, or use Print.';
    } finally {
      download.disabled = false;
    }
  });
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-end: 10px;
    color: var(--a-ink-2);
    font-size: var(--ui-a-md);
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .head-actions [data-download]:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px;
  }
  .panel {
    flex: 1 1 340px;
    max-width: 520px;
    padding: 18px 20px 20px;
  }
  .panel__title {
    margin-block-end: 14px;
    font-size: var(--ui-a-base);
    font-weight: 700;
  }
  .panel__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-block-start: 16px;
  }
  .panel .a-hint {
    margin-block-start: 12px;
  }
  .panel__actions .a-hint {
    margin: 0;
  }
  .grid2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
  }
  .wide {
    grid-column: 1 / -1;
  }
  .a-input:invalid {
    border-color: var(--red);
  }
  [data-saved-alert] {
    transition: opacity 400ms ease-out;
  }
  [data-saved-alert].is-leaving {
    opacity: 0;
  }

  /* ---------- the card ----------
     Everything inside is in mm/pt so the print is true to size. On screen the
     preview is zoomed; in print it is 1:1, one side per page. */
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    zoom: 1.9;
  }
  .pc {
    --ui-pc-press: 15pt;
    --ui-pc-name: 11pt;
    --ui-pc-no: 7.5pt;
    --ui-pc-ur: 8pt;
    --ui-pc-md: 6.5pt;
    --ui-pc-sm: 5.5pt;
    --ui-pc-xs: 4.6pt;
    /* Print palette: crimson (C22 M98 Y94 K15), charcoal, off-white, divider grey, rich black. */
    --pc-red: #8f1d1d;
    --pc-charcoal: #1d262f;
    --pc-royal: #142b6e; /* darker royal blue, deep enough for white text in print */
    --pc-paper: #fafafa;
    --pc-line: #eaeaea;
    --pc-ink: #1a1a1a;
    --pc-muted: #5c5c5c;
    position: relative;
    isolation: isolate;
    display: flex;
    width: 54mm;
    height: 85.6mm;
    overflow: hidden;
    border-radius: 3.18mm;
    background: var(--pc-paper);
    color: var(--pc-ink);
    font-family: var(--font-ui);
    line-height: 1.3;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 6px 18px rgb(0 0 0 / 0.1);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  .pc p {
    margin: 0;
  }

  /* front */
  .pc__spine {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 10mm;
    padding: 3mm 0 4mm;
    background: var(--pc-red);
    color: #ffffff;
  }
  /* Punch hole: 3 mm with a pale ring; the wordmark starts well below so a lanyard clip never clips the P. */
  .pc__hole {
    width: 3mm;
    height: 3mm;
    margin-block-end: 3mm;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 0.6mm rgb(255 255 255 / 0.4);
  }
  .pc__press,
  .pc__country {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .pc__press {
    font-size: var(--ui-pc-press);
    font-weight: 700;
    letter-spacing: 0.22em;
  }
  .pc__country {
    font-size: var(--ui-pc-xs);
    letter-spacing: 0.2em;
  }
  .pc__body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 3.5mm 3.5mm 3.5mm;
  }
  /* Background globe: right side, part of it off the edge, between the dateline and the footer, behind the photo and text. */
  .pc__globe {
    position: absolute;
    z-index: -1;
    inset-inline-end: -19mm;
    inset-block-start: 19mm;
    width: 50mm;
    height: 50mm;
    opacity: 0.12;
    pointer-events: none;
  }
  .pc__globe :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The printed paishani, whole, as it appears above the paper. */
  .pc__paishani {
    display: block;
    width: 100%;
    height: auto;
  }
  /* A band between the paishani and the rule: the same air above and below the text. */
  .pc__dateline {
    padding-block: 1.6mm;
    border-bottom: 0.25mm solid var(--pc-line);
    font-size: var(--ui-pc-xs);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.16em;
    text-align: center;
    color: var(--pc-ink);
  }
  .pc__photo {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 19mm;
    height: 23.75mm;
    margin: 2.5mm auto 2mm;
    padding: 0.7mm;
    overflow: hidden;
    /* An inset shadow, not a border: the PDF renderer rounds sub-pixel borders up to a whole pixel. */
    box-shadow: inset 0 0 0 0.18mm #d6d6d6;
    border-radius: 1mm;
    background: #ffffff;
    color: var(--pc-muted);
    font-size: var(--ui-pc-sm);
  }
  .pc__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.5mm;
  }
  .pc__name {
    font-family: var(--font-serif);
    font-size: var(--ui-pc-name);
    font-weight: 700;
    line-height: 1.05;
    text-align: center;
  }
  .pc__name-ur {
    margin-block-start: 0.6mm;
    font-family: var(--font-naskh);
    font-size: var(--ui-pc-ur);
    line-height: 1.5;
    text-align: center;
  }
  .pc__role {
    margin-block-start: 0.6mm;
    text-align: center;
    /* letter-spacing adds a trailing gap; pull it back so the word sits truly centred */
    margin-inline-end: -0.12em;
    color: var(--pc-red);
    font-size: var(--ui-pc-md);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pc__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2mm;
    margin-block-start: auto;
    padding-block-start: 1mm;
    border-top: 0.25mm solid var(--pc-line);
  }
  .pc__k {
    font-size: var(--ui-pc-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--pc-muted);
  }
  .pc__mono {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
  .pc__no {
    margin-block-start: 0.4mm;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: var(--ui-pc-no);
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
  }
  .pc__qr {
    display: grid;
    gap: 0.6mm;
    justify-items: center;
  }
  .pc__qr .pc__k {
    letter-spacing: 0.1em;
  }
  /* 10 mm code inside a white box: the 1.5 mm padding plus the card margin is the quiet zone. */
  .pc__qr-code {
    width: 12.4mm;
    height: 12.4mm;
    padding: 1.2mm;
    border-radius: 0.6mm;
    background: #ffffff;
  }
  .pc__qr-svg,
  .pc__qr-svg :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pc__qr-code--empty {
    display: grid;
    place-items: center;
    border: 0.25mm dashed #b5b3ad;
    color: var(--pc-muted);
    font-size: var(--ui-pc-xs);
    text-align: center;
  }

  /* back */
  .pc--back {
