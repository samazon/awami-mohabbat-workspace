---
/**
 * Footer: the design's four columns — print masthead + tagline, رابطہ
 * (contact), صفحات (sections), فالو کریں (follow) — then a sub-bar with the
 * copyright and the chief editor, recoloured onto the navigation band's ink.
 * Footer text is Naskh / the body serif, not Nastaliq.
 */
import { Image } from 'astro:assets';
import masthead from '@/assets/masthead-print.webp';
import { t, type Locale } from '@/i18n';
import { nav as navFor } from '@/lib/links';
import type { SiteConfigView } from '@/lib/services/config';
import Icon from './Icon.astro';
import LtrRun from './LtrRun.astro';

interface Props {
  locale: Locale;
  config: SiteConfigView | null;
}
const { locale, config } = Astro.props;
const s = t(locale);
const links = navFor(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="col col--brand">
        {/* The print masthead, as a clipping: it carries its own white ground. */}
        <a class="logo" href={links.home} aria-label={s.meta.siteName}>
          <Image src={masthead} alt="" widths={[300, 600]} sizes="300px" format="webp" loading="lazy" />
        </a>
        <p class="tagline">{s.footer.tagline}</p>
      </div>

      {config && (
        <div class="col">
          <h2 class="label">{s.footer.contact}</h2>
          <ul class="list">
            <li class="row">
              <span class="row__text"><span class="row__k">{s.footer.office}:</span> {config.office}</span>
            </li>
            {config.bureau && (
              <li class="row">
                <span class="row__text"><span class="row__k">{s.footer.bureau}:</span> {config.bureau}</span>
              </li>
            )}
            {config.phones.map((p) => (
              <li class="row row--icon">
                <Icon name="phone" size="sm" class="row__icon" />
                <LtrRun tabular><a class="plain" href={`tel:${p.tel}`} aria-label={`${s.footer.phone}: ${p.display}`}>{p.display}</a></LtrRun>
              </li>
            ))}
            <li class="row row--icon">
              <Icon name="mail" size="sm" class="row__icon" />
              <LtrRun><a href={`mailto:${config.email}`} aria-label={`${s.footer.email}: ${config.email}`}>{config.email}</a></LtrRun>
            </li>
          </ul>
        </div>
      )}

      <nav class="col" aria-label={s.a11y.footerNav}>
        <h2 class="label">{s.footer.sections}</h2>
        <ul class="list links">
          <li><a class="plain" href={links.archive}>{s.footer.archive}</a></li>
          <li><a class="plain" href={links.articles}>{s.footer.articles}</a></li>
          <li><a class="plain" href={links.about}>{s.nav.about}</a></li>
          <li><a class="plain" href={links.contact}>{s.contact.title}</a></li>
        </ul>
      </nav>

      {config && config.social.length > 0 && (
        <div class="col">
          <h2 class="label">{s.footer.follow}</h2>
          <ul class="list links">
            {config.social.map((x) => (
              <li><LtrRun><a class="plain" href={x.url} target="_blank" rel="noopener">{x.label}</a></LtrRun></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="sub">
      <LtrRun>{s.footer.copyright(year)}</LtrRun>
      {config && <span>{s.footer.chiefEditor}: {config.editor}</span>}
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: 8px;
    border-block-start: 3px solid var(--strip-bg);
    background: var(--nav-bg);
    color: var(--on-dark);
    font-family: var(--font-body);
    line-height: 1.9;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px 40px;
    padding: 34px 0 28px;
  }
  /* Tablet: a balanced 2×2 — brand + contact, then sections + follow. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Desktop: as designed — brand and contact wide, sections and follow narrow,
     so the two office addresses stay on one line each. */
  @media (min-width: 1024px) {
    .cols {
      grid-template-columns: 1.1fr 1.5fr 0.9fr 0.6fr;
    }
  }
  .col {
    min-width: 0;
  }

  /* brand */
  .logo {
    display: block;
    max-width: 300px;
    border: 1px solid var(--on-dark-rule);
    background: #ffffff;
  }
  .logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tagline {
    padding-block-start: 12px;
    font-size: var(--fs-card);
    color: var(--on-dark-muted);
  }

  /* column labels: small, muted, in the reader's script */
  .label {
    margin-block-end: 8px;
    font-family: var(--font-body);
    font-size: var(--ui-meta);
    font-weight: 400;
    color: var(--on-dark-muted);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-card);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .row--icon {
    align-items: center;
  }
  .row__icon {
    flex: none;
    color: var(--on-dark-muted);
  }
  .row__k {
    color: var(--on-dark-muted);
  }
  /* the email keeps the brand accent, which on ink is gold */
  .list a:not(.plain) {
    color: var(--gold);
  }
  .list a:not(.plain):hover {
    color: #e6c15e;
  }
  /* numbers and the address are UI chrome, not prose — Plex, not the body serif */
  .list :global(.ltr) {
    font-family: var(--font-ui);
  }

  .links li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
  }
  .plain {
    color: var(--on-dark);
  }
  .plain:hover {
    color: var(--gold);
  }

  .sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 20px;
    padding: 14px 0 18px;
    border-block-start: 1px solid var(--on-dark-rule);
    font-size: var(--ui-caption);
    color: var(--on-dark-muted);
  }
  .sub :global(.ltr) {
    font-family: var(--font-ui); /* the copyright line is chrome, set in Plex as designed */
  }
</style>
