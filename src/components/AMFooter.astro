---
/**
 * Footer, reimagined: four columns on ink — brand, links, offices & contact,
 * legal — under a deep-red rule, then a copyright line. Headings in Nastaliq
 * (serif in English); body in Naskh / the body serif.
 */
import { t, type Locale } from '@/i18n';
import { nav as navFor } from '@/lib/links';
import type { SiteConfigView } from '@/lib/services/config';
import LtrRun from './LtrRun.astro';

interface Props {
  locale: Locale;
  config: SiteConfigView | null;
}
const { locale, config } = Astro.props;
const s = t(locale);
const links = navFor(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="cols">
      <div class="col">
        <h2 class="h">{s.footer.brandTitle}</h2>
        <p class="body">{s.footer.brandBlurb}</p>
        <LtrRun class="abc">{s.footer.abcLine}</LtrRun>
      </div>

      <nav class="col" aria-label={s.a11y.footerNav}>
        <h2 class="h">{s.footer.sections}</h2>
        <ul class="list">
          <li><a class="link" href={links.home}>{s.nav.home}</a></li>
          <li><a class="link" href={links.archive}>{s.footer.archive}</a></li>
          <li><a class="link" href={links.articles}>{s.footer.articles}</a></li>
          <li><a class="link" href={links.about}>{s.footer.aboutContact}</a></li>
        </ul>
      </nav>

      {config && (
        <div class="col">
          <h2 class="h">{s.footer.contact}</h2>
          <ul class="list body">
            <li><span class="k">{s.footer.office}:</span> {config.office}</li>
            {config.bureau && <li><span class="k">{s.footer.bureau}:</span> {config.bureau}</li>}
            <li><span class="k">{s.footer.chiefEditor}:</span> {config.editor}</li>
            {config.phones.map((p) => (
              <li class="row">
                <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.6 2.6.7a2 2 0 0 1 1.7 2z" /></svg>
                <LtrRun tabular><a class="link" href={`tel:${p.tel}`} aria-label={`${s.footer.phone}: ${p.display}`}>{p.display}</a></LtrRun>
              </li>
            ))}
            <li class="row">
              <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" /><path d="m2.5 7 9.5 6.5L21.5 7" /></svg>
              <LtrRun><a class="link link--accent" href={`mailto:${config.email}`} aria-label={`${s.footer.email}: ${config.email}`}>{config.email}</a></LtrRun>
            </li>
          </ul>
        </div>
      )}

      <div class="col">
        <h2 class="h">{s.footer.legal}</h2>
        <p class="body body--small">{s.footer.rights}</p>
        {config && config.social.length > 0 && (
          <ul class="social">
            {config.social.map((x) => (
              <li><LtrRun><a class="link" href={x.url} target="_blank" rel="noopener">{x.label}</a></LtrRun></li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="sub">
      <LtrRun>{s.footer.copyright(year)}</LtrRun>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: 8px;
    border-block-start: 3px solid var(--strip-bg);
    background: var(--footer-bg);
    color: var(--on-dark);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1.2fr 1fr;
    gap: 32px 48px;
    padding: 40px 0 32px;
  }
  .col {
    min-width: 0;
  }
  .h {
    margin-block-end: 12px;
    font-family: var(--font-nastaliq);
    font-size: var(--fs-section);
    font-weight: 700;
    line-height: 1.9;
    color: var(--on-dark);
  }
  :global(html[lang='en']) .h {
    font-family: var(--font-serif);
    line-height: 1.3;
  }
  .body {
    font-family: var(--font-naskh);
    font-size: var(--fs-card);
    line-height: 1.9;
    color: var(--on-dark-muted);
  }
  :global(html[lang='en']) .body {
    font-family: var(--font-serif);
    line-height: 1.6;
  }
  .body--small {
    font-size: var(--ui-meta);
  }
  .abc {
    display: inline-block;
    margin-block-start: 14px;
    font-family: var(--font-ui);
    font-size: var(--ui-meta);
    color: var(--gold);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .list .k {
    color: var(--on-dark);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon {
    flex: none;
    color: var(--on-dark-muted);
  }
  .list :global(.ltr) {
    font-family: var(--font-ui);
  }
  .link {
    color: var(--on-dark);
    text-decoration: none;
  }
  .list > li > .link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-family: var(--font-naskh);
    font-size: var(--fs-card);
  }
  :global(html[lang='en']) .list > li > .link {
    font-family: var(--font-ui);
  }
  .link:hover {
    color: var(--gold);
    text-decoration: none;
  }
  .link--accent {
    color: var(--gold);
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-block-start: 14px;
  }
  .social .link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-family: var(--font-ui);
    font-size: var(--ui-nav);
  }
  .sub {
    padding: 16px 0 22px;
    border-block-start: 1px solid var(--on-dark-rule);
    font-family: var(--font-ui);
    font-size: var(--ui-caption);
    color: var(--on-dark-muted);
    text-align: end;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 639px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 32px 0 24px;
    }
    .sub {
      text-align: center;
    }
  }
</style>
