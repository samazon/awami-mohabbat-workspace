---
/**
 * /about — to design screen 06: title, then mission beside the editor card,
 * then three columns: editorial team, publication details, contact. No ads.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import fallbackPhoto from '@/assets/team/iqbal-danial-khokhar.webp';
import { getTeamPage } from '@/lib/services/team';
import { t, type Locale } from '@/i18n';
import { about } from '@/content/about';
import { getSiteConfig } from '@/lib/services/config';
import { getLatestEdition } from '@/lib/services/editions';
import AMHeader from './AMHeader.astro';
import AMFooter from './AMFooter.astro';
import LtrRun from './LtrRun.astro';
import Icon from './Icon.astro';
import { editorMessage } from '@/content/editor-message';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const c = about[locale];
const [config, edition, team] = await Promise.all([getSiteConfig(locale), getLatestEdition(locale), getTeamPage()]);
// The featured team member's photo (edited in /admin/team), or the bundled one.
const editorPhoto = team.featured?.photo ?? fallbackPhoto;
// Signature: the featured team member's Urdu name (admin-edited), else the masthead name.
const signName = team.featured?.nameUr ?? about.ur.editor.name;
---

<BaseLayout title={`${s.about.title} — ${s.meta.siteName}`} description={s.about.description}>
  <AMHeader slot="header" locale={locale} active="about" />

  <div class="container">
    <h1 class="title t-head">{s.about.title}</h1>

    <div class="intro">
      <section class="mission" aria-labelledby="mission-h">
        <h2 id="mission-h" class="h2">{s.about.mission}</h2>
        {c.mission.map((p) => <p class="t-body prose">{p}</p>)}
      </section>

      <section class="editor" aria-label={c.editor.role}>
        <img class="editor__photo" src={editorPhoto.src} width={editorPhoto.width} height={editorPhoto.height} alt={c.editor.name} loading="eager" decoding="async" />
        <div class="editor__text">
          <h2 class="editor__name t-head">{c.editor.name}</h2>
          <p class="editor__role">{c.editor.role}</p>
          <p class="t-body editor__bio">{c.editor.bio}</p>
          <a class="editor__more" href="#editor-message">{s.about.readMessage} <Icon name="arrow-down" size="sm" /></a>
        </div>
      </section>
    </div>

    <section class="message" id="editor-message" aria-labelledby="message-h">
      <header class="message__head">
        <span class="message__quote" aria-hidden="true">”</span>
        <h2 id="message-h" class="h2 message__title">{s.about.message}</h2>
        {s.about.messageInUrdu && <span class="message__lang">{s.about.messageInUrdu}</span>}
      </header>
      <div class="message__body" lang="ur" dir="rtl">
        {editorMessage.paragraphs.map((p) => <p>{p}</p>)}
        <p class="message__closing">{editorMessage.closing.map((l) => <span>{l}</span>)}</p>
        <footer class="message__sign">
          <span class="message__name">{signName}</span>
          <span class="message__role">چیف ایڈیٹر و پبلشر، روزنامہ عوامی محبت</span>
        </footer>
      </div>
    </section>

    <div class="details">
      <section aria-labelledby="staff-h">
        <h2 id="staff-h" class="h2">{s.about.staff}</h2>
        <dl class="rows">
          {c.staff.map((m) => (
            <div class="row">
              <dt>{m.role}</dt>
              <dd>{m.name}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="pub-h">
        <h2 id="pub-h" class="h2">{s.about.publication}</h2>
        <dl class="rows">
          <div class="row"><dt>{s.about.frequency}</dt><dd>{c.publication.frequency}</dd></div>
          {config && <div class="row"><dt>{s.about.area}</dt><dd>{config.coverage}</dd></div>}
          <div class="row"><dt>{s.about.language}</dt><dd>{c.publication.language}</dd></div>
          <div class="row"><dt>{s.about.printedAt}</dt><dd>{c.publication.printedAt}</dd></div>
          <div class="row"><dt>{s.about.certification}</dt><dd><LtrRun class="abc">{s.strip.abc}</LtrRun></dd></div>
        </dl>
      </section>

      {config && (
        <section aria-labelledby="contact-h">
          <h2 id="contact-h" class="h2">{s.about.contact}</h2>
          <ul class="contact t-body">
            <li><span class="k">{s.footer.office}:</span> {config.officeLines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</li>
            {config.bureau && <li><span class="k">{s.footer.bureau}:</span> {config.bureau}</li>}
            {config.phones.map((p) => (
              <li><LtrRun tabular><a class="plain" href={`tel:${p.tel}`}>{p.display}</a></LtrRun></li>
            ))}
            <li><LtrRun><a href={`mailto:${config.email}`}>{config.email}</a></LtrRun></li>
          </ul>
        </section>
      )}
    </div>
  </div>

  <AMFooter slot="footer" locale={locale} config={config} />
</BaseLayout>

<style>
  .title {
    padding: 34px 0 14px;
    font-size: var(--fs-h1);
    border-block-end: 1px solid var(--ink);
  }
  .h2 {
    margin-block-end: 14px;
    font-family: var(--font-head);
    line-height: var(--lh-head);
    font-size: var(--fs-section);
    font-weight: 700;
    color: var(--ink);
  }

  /* mission (wide) beside the editor card */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px 60px;
    padding: 30px 0 40px;
    border-block-end: 1px solid var(--rule);
  }
  .prose {
    max-width: var(--measure-body);
    font-size: var(--fs-body);
  }
  .prose + .prose {
    margin-block-start: 14px;
  }

  .editor {
    display: flex;
    gap: 22px;
    align-items: flex-start;
  }
  .editor__photo {
    flex: none;
    display: block;
    width: 176px;
    height: auto;
    aspect-ratio: 1 / 1.2;
    object-fit: cover;
    object-position: 50% 20%;
    background: var(--thumb-ground);
    border-radius: var(--radius-sm);
    box-shadow:
      0 0 0 1px rgba(17, 17, 17, 0.08),
      0 6px 18px rgba(17, 17, 17, 0.12);
  }
  .editor__text {
    min-width: 0;
    padding-block-start: 4px;
  }
  .editor__name {
    font-size: var(--fs-section);
  }
  .editor__role {
    font-family: var(--font-label);
    line-height: var(--lh-label);
    font-size: var(--ui-meta);
    color: var(--red);
  }
  .editor__bio {
    margin-block-start: 10px;
    font-size: var(--fs-card);
  }

  .editor__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: 12px;
    font-family: var(--font-label);
    line-height: var(--lh-label);
    font-size: var(--ui-meta);
    font-weight: 700;
    color: var(--red);
    text-decoration: none;
  }
  .editor__more:hover {
    text-decoration: underline;
  }

  /* the chief editor's message */
  .message {
    scroll-margin-block-start: 16px;
    padding: 36px 0 40px;
    border-block-end: 1px solid var(--rule);
  }
  .message__head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    max-width: 780px;
    margin-inline: auto;
    padding-block-end: 14px;
    border-block-end: 3px solid var(--red);
  }
  .message__quote {
    font-family: var(--font-serif);
    font-size: var(--fs-title);
    line-height: 0.6;
    color: var(--red);
  }
  .message__title {
    margin: 0;
  }
  .message__lang {
    font-family: var(--font-ui);
    font-size: var(--ui-meta);
    color: var(--muted);
  }
  .message__body {
    max-width: 780px;
    margin-inline: auto;
    padding-block-start: 18px;
    font-family: var(--font-naskh);
    font-size: var(--fs-body);
    line-height: var(--lh-naskh);
    color: var(--body);
    text-align: justify;
  }
  .message__body p + p {
    margin-block-start: 16px;
  }
  .message__closing {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-block-start: 22px;
    font-weight: 700;
    color: var(--ink);
    text-align: start;
  }
  .message__sign {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-block-start: 22px;
  }
  .message__name {
    font-family: var(--font-nastaliq);
    line-height: var(--lh-nastaliq);
    font-size: var(--fs-section);
    font-weight: 700;
    color: var(--ink);
  }
  .message__role {
    font-family: var(--font-label);
    font-size: var(--ui-meta);
    color: var(--red);
  }

  /* three detail columns */
  .details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 60px;
    padding: 34px 0 48px;
  }
  .rows {
    margin: 0;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 10px 0;
    border-block-end: 1px solid var(--hairline);
  }
  .row dt {
    font-family: var(--font-body);
    line-height: var(--lh-body);
    font-size: var(--fs-card);
    color: var(--muted);
  }
  .row dd {
    margin: 0;
    font-family: var(--font-body);
    line-height: var(--lh-body);
    font-size: var(--fs-card);
    color: var(--ink);
    text-align: end;
  }
  .abc {
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid var(--red);
    font-family: var(--font-ui);
    font-size: var(--ui-eyebrow-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--red);
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--fs-card);
  }
  .contact .k {
    color: var(--secondary);
  }
  .contact :global(.ltr) {
    font-family: var(--font-ui);
  }
  .plain {
    color: var(--ink);
  }
  .plain:hover {
    color: var(--red);
  }

  @media (max-width: 1023px) {
    .details {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 767px) {
    .intro,
    .details {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .editor__photo {
      width: 120px;
    }
  }
</style>
