---
import type { Locale } from '@/i18n';
import type { ColumnCardView } from '@/lib/services/columns';
import ColumnCard from './ColumnCard.astro';

interface Props {
  columns: ColumnCardView[];
  locale: Locale;
}
const { columns, locale } = Astro.props;
---

<div class="grid">
  {columns.map((c) => <ColumnCard column={c} locale={locale} />)}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 32px;
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
