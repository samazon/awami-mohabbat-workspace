---
/**
 * /archive — one month of editions (the current one, or the latest with papers),
 * all on one page, plus a date picker for anything older. The paper isn't
 * published every day and isn't back-filled, so there is nothing to browse
 * month by month; a date with no paper says so plainly.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath, t, type Locale } from '@/i18n';
import { formatLong } from '@/lib/dates';
import { getEditionsInMonth } from '@/lib/services/editions';
import { getSiteConfig } from '@/lib/services/config';
import type { ArchiveState } from '@/lib/archive-route';
import AMHeader from './AMHeader.astro';
import AMFooter from './AMFooter.astro';
import ArchiveCards from './ArchiveCards.astro';
import LtrRun from './LtrRun.astro';

interface Props extends ArchiveState {
  locale: Locale;
}
const { locale, year, month, missingDate, minDate, maxDate } = Astro.props;
const s = t(locale);

const [config, result] = await Promise.all([getSiteConfig(locale), getEditionsInMonth(locale, year, month, { perPage: 31 })]);
const monthName = (m: number) => s.archive.months[m - 1] ?? String(m);
const base = localePath(locale, '/archive');
---

<BaseLayout title={`${s.archive.pageTitle} — ${s.meta.siteName}`} description={s.archive.description}>
  <AMHeader slot="header" locale={locale} active="archive" />

  <div class="container">
    <header class="head">
      <h1 class="title t-head">{s.archive.pageTitle}</h1>
      <p class="sub">{s.archive.subtitle}</p>
    </header>

    <form class="pick" method="get" action={base}>
      <label class="pick__label" for="pick">{s.archive.pickDate}</label>
      <div class="date">
        <input id="pick" class="date__input" type="date" name="date" min={minDate} max={maxDate} value={missingDate ?? ''} required />
        <button type="submit" class="date__go t-label">{s.archive.go}</button>
      </div>
    </form>

    {missingDate && <p class="notice">{s.archive.noEditionOn(formatLong(missingDate))}</p>}

    {/* month heading */}
    <div class="month-head">
      <h2 class="month-title"><span class="t-label">{monthName(month)}</span> <LtrRun>{year}</LtrRun></h2>
      <span class="month-count">{s.archive.editionsCount(result.total)}</span>
    </div>

    {result.items.length > 0 ? <ArchiveCards editions={result.items} locale={locale} /> : <p class="empty t-body">{s.archive.empty}</p>}
  </div>

  <AMFooter slot="footer" locale={locale} config={config} />
</BaseLayout>

<style>
  .t-label {
    font-family: var(--font-label);
    line-height: var(--lh-label);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
    padding: 34px 0 14px;
    border-block-end: 1px solid var(--ink);
  }
  .title {
    font-size: var(--fs-h1);
  }
  .sub {
    font-family: var(--font-body);
    line-height: var(--lh-body);
    font-size: var(--fs-card);
    color: var(--secondary);
  }

  .pick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 22px 0 20px;
    border-block-end: 1px solid var(--rule);
  }
  .pick__label {
    font-family: var(--font-body);
    line-height: var(--lh-body);
    font-size: var(--fs-card);
    color: var(--secondary);
  }
  .date {
    display: flex;
  }
  .date__input {
    min-height: var(--control-h);
    padding: 0 10px;
    border: 1px solid var(--ink);
    border-inline-end: 0;
    background: var(--surface);
    font-family: var(--font-ui);
    font-size: var(--ui-nav);
    color: var(--ink);
  }
  .date__go {
    min-height: var(--control-h);
    padding: 0 14px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--on-red);
    font-size: var(--ui-nav);
  }
  .date__go:hover {
    background: var(--red);
    border-color: var(--red);
  }
  .notice {
    margin-block-start: 16px;
    padding: 10px 14px;
    border: 1px solid var(--red);
    font-family: var(--font-body);
    line-height: var(--lh-body);
    font-size: var(--fs-card);
    color: var(--red);
  }

  .month-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
    padding: 22px 0 16px;
  }
  .month-title {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: var(--fs-section);
    font-weight: 700;
    color: var(--ink);
  }
  .month-count {
    font-family: var(--font-body);
    line-height: var(--lh-body);
    font-size: var(--ui-meta);
    color: var(--muted);
  }
  .empty {
    padding: 30px 0 40px;
    font-size: var(--fs-body);
    color: var(--secondary);
  }

</style>
