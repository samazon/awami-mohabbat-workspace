---
/** The archive's edition cards: front page at 1/1.414, date, headline. Shared by the homepage strip and /archive. */
import { localePath, t, type Locale } from '@/i18n';
import { formatShort } from '@/lib/dates';
import type { EditionCard } from '@/lib/services/editions';
import LtrRun from './LtrRun.astro';
import PageThumb from './PageThumb.astro';

interface Props {
  editions: EditionCard[];
  locale: Locale;
}
const { editions, locale } = Astro.props;
const s = t(locale);
---

<div class="grid">
  {editions.map((e) => (
    <article class="card">
      <PageThumb
        page={{ thumb: e.thumb ?? '' }}
        alt={s.a11y.edition(formatShort(e.date))}
        href={localePath(locale, `/edition/${e.date}`)}
        sizes="(max-width: 767px) 45vw, 170px"
      >
        <LtrRun block class="card__date">{formatShort(e.date)}</LtrRun>
        <h3 class="card__title" lang={e.translation.locale}>{e.headline}</h3>
      </PageThumb>
    </article>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 26px 18px;
  }
  .card__date {
    padding-block-start: 8px;
    font-family: var(--font-ui);
    font-size: var(--ui-caption);
    color: var(--muted);
  }
  .card__title {
    font-family: var(--font-label);
    line-height: var(--lh-label);
    font-size: var(--fs-card);
    font-weight: 600;
    color: var(--ink);
  }
</style>
