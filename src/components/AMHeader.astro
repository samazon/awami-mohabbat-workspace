---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-awami-mohabbat.png';
import { t, type Locale } from '@/i18n';
import { formatLong } from '@/lib/dates';
import { nav as navFor } from '@/lib/links';
import type { SiteConfigView } from '@/lib/services/config';
import LtrRun from './LtrRun.astro';
import ReaderControls from './ReaderControls.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  config: SiteConfigView | null;
  masthead: { date: string; hijriDate: string } | null;
  active?: 'home' | 'archive' | 'articles' | 'about';
}
const { locale, config, masthead, active = 'home' } = Astro.props;
const s = t(locale);
const links = navFor(locale);
const pathname = Astro.url.pathname;

const items = [
  { key: 'home', href: links.home, label: s.nav.home },
  { key: 'archive', href: links.archive, label: s.nav.archive },
  { key: 'articles', href: links.articles, label: s.nav.articles },
  { key: 'about', href: links.about, label: s.nav.about },
] as const;

/** Transparent 1×1 GIF: what phones fetch instead of the masthead emblems. */
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<div class="strip">
  <div class="container strip__row">
    <span class="strip__group">{s.strip.group}</span>
    <LtrRun class="strip__abc">{s.strip.abc}</LtrRun>
    <span class="strip__tagline">{s.strip.tagline}</span>
  </div>
</div>

<header class="header">
  <div class="container">
    <div class="row1">
      <nav class="nav" aria-label={s.a11y.mainNav}>
        {items.map((i) => (
          <a class="nav__link t-label" href={i.href} aria-current={i.key === active ? 'page' : undefined}>{i.label}</a>
        ))}
      </nav>

      <div class="tools">
        <ReaderControls locale={locale} class="tools__reader" />
        <LanguageSwitcher locale={locale} pathname={pathname} class="tools__lang" />
        <form class="search" role="search" action={links.search} method="get">
          <label class="visually-hidden" for="q">{s.search.label}</label>
          <svg class="search__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M16.5 16.5 21 21" /></svg>
          <input id="q" class="search__input t-label" type="search" name="q" placeholder={s.search.placeholder} autocomplete="off" />
        </form>
      </div>

      <am-mobile-nav class="mobile">
        <button type="button" class="iconbtn" data-menu aria-expanded="false" aria-controls="mobile-drawer" aria-label={s.nav.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <button type="button" class="iconbtn" data-search-toggle aria-expanded="false" aria-controls="mobile-search" aria-label={s.search.label}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M16.5 16.5 21 21" /></svg>
        </button>

        <form id="mobile-search" class="msearch" role="search" action={links.search} method="get" data-search-row hidden>
          <label class="visually-hidden" for="q-mobile">{s.search.label}</label>
          <input id="q-mobile" class="msearch__input t-label" type="search" name="q" placeholder={s.search.placeholder} autocomplete="off" enterkeyhint="search" />
          <button type="submit" class="msearch__submit t-label">{s.search.label}</button>
        </form>

        <dialog id="mobile-drawer" class="drawer" aria-label={s.nav.menu}>
          <div class="drawer__head">
            <a class="drawer__logo" href={links.home} aria-label={s.meta.siteName}>
              <Image src={logo} alt="" widths={[150, 300]} sizes="150px" format="webp" loading="lazy" />
            </a>
            <button type="button" class="iconbtn" data-close aria-label={s.nav.close} autofocus>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
            </button>
          </div>
          <nav class="drawer__nav" aria-label={s.a11y.mainNav}>
            {items.map((i) => (
              <a class="drawer__link t-label" href={i.href} aria-current={i.key === active ? 'page' : undefined}>{i.label}</a>
            ))}
          </nav>
          <div class="drawer__tools">
            <LanguageSwitcher locale={locale} pathname={pathname} class="drawer__wide" />
            <ReaderControls locale={locale} class="drawer__wide" />
          </div>
          <p class="drawer__foot">{s.strip.tagline}</p>
        </dialog>
      </am-mobile-nav>
    </div>

    <div class="masthead">
      {/* Start side: the flag. Decorative — screen readers skip it; a still
          frame is served when the reader prefers reduced motion. */}
      <picture class="masthead__emblem masthead__emblem--flag">
        {/* phones hide the emblems — serve a 1px pixel so nothing is downloaded */}
        <source srcset={PIXEL} media="(max-width: 767px)" />
        <source srcset="/img/flag-pk-static.webp" media="(prefers-reduced-motion: reduce)" type="image/webp" />
        <img src="/img/flag-pk.webp" alt="" width="220" height="147" loading="eager" decoding="async" />
      </picture>

      <div class="masthead__center">
        <span class="masthead__kicker t-label">{s.masthead.daily}</span>
        <a class="masthead__logo" href={links.home} aria-label={s.meta.siteName}>
          <Image
            src={logo}
            alt={s.meta.siteName}
            widths={[250, 340, 500, 680]}
            sizes="(max-width: 767px) 250px, 340px"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </a>
        <LtrRun class="masthead__latin">AWAMI MOHABBAT</LtrRun>
      </div>

      {/* End side: the globe, slowed to ~10s per turn. */}
      <picture class="masthead__emblem masthead__emblem--globe">
        <source srcset={PIXEL} media="(max-width: 767px)" />
        <source srcset="/img/globe-static.webp" media="(prefers-reduced-motion: reduce)" type="image/webp" />
        <img src="/img/globe.webp" alt="" width="200" height="200" loading="eager" decoding="async" />
      </picture>
    </div>

    <div class="dateline">
      {/* Vol/Issue numbering is a print artefact — only the date belongs online. */}
      <LtrRun class="dateline__start">
        {masthead && <span class="dateline__date">{formatLong(masthead.date)} &nbsp;|&nbsp; {masthead.hijriDate}</span>}
      </LtrRun>
      {config && (
        <span class="dateline__end t-label">
          <span>{config.coverage}</span>
          <span class="dateline__dot" aria-hidden="true">·</span>
          <span>{s.masthead.chiefEditor}: {config.editor}</span>
        </span>
      )}
    </div>
  </div>
</header>

<script>
  /**
   * Phone chrome: a <dialog> drawer (native focus trap, Escape, top layer) and
   * an expandable search row. Both buttons reflect state via aria-expanded.
   */
  class MobileNav extends HTMLElement {
    connectedCallback() {
      const menuBtn = this.querySelector<HTMLButtonElement>('[data-menu]');
      const drawer = this.querySelector<HTMLDialogElement>('dialog.drawer');
      const closeBtn = drawer?.querySelector<HTMLButtonElement>('[data-close]');
      const searchBtn = this.querySelector<HTMLButtonElement>('[data-search-toggle]');
      const searchRow = this.querySelector<HTMLFormElement>('[data-search-row]');
      const searchInput = searchRow?.querySelector<HTMLInputElement>('input');
      if (!menuBtn || !drawer || !closeBtn || !searchBtn || !searchRow || !searchInput) return;

      const root = document.documentElement;

      const openDrawer = () => {
        if (drawer.open) return;
        drawer.showModal();
        menuBtn.setAttribute('aria-expanded', 'true');
        root.classList.add('drawer-open');
      };
      const closeDrawer = () => {
        if (drawer.open) drawer.close();
      };
      menuBtn.addEventListener('click', openDrawer);
      closeBtn.addEventListener('click', closeDrawer);
      // Native `close` fires for Escape, close(), and form method=dialog alike.
      drawer.addEventListener('close', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        root.classList.remove('drawer-open');
        menuBtn.focus();
      });
      // A tap on the backdrop lands on the dialog element itself.
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) closeDrawer();
      });

      const setSearch = (open: boolean) => {
        searchRow.hidden = !open;
        searchBtn.setAttribute('aria-expanded', String(open));
        if (open) searchInput.focus();
      };
      searchBtn.addEventListener('click', () => setSearch(searchRow.hasAttribute('hidden')));
      searchRow.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setSearch(false);
          searchBtn.focus();
        }
      });
    }
  }
  if (!customElements.get('am-mobile-nav')) customElements.define('am-mobile-nav', MobileNav);
</script>

<style>
  /* Labels in the reader's script (Nastaliq for Urdu, Plex for English). */
  .t-label {
    font-family: var(--font-label);
    line-height: var(--lh-label);
  }

  /* ---- red utility strip: group at start · ABC badge dead-centre · tagline at end.
          Urdu runs in Nastaliq (13px/2.1 and 12px/2.2), badge 10px/600. ---- */
  .strip {
    background: var(--red);
    color: var(--on-red);
  }
  .strip__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding-block: 7px;
  }
  .strip__group {
    justify-self: start;
    font-family: var(--font-nastaliq);
    font-size: var(--ui-search);
    line-height: 2.1;
  }
  .strip__tagline {
    justify-self: end;
    text-align: end;
    font-family: var(--font-nastaliq);
    font-size: var(--ui-meta);
    line-height: 2.2;
  }
  .strip__abc {
    justify-self: center;
    display: inline-block;
    padding: 3px 7px;
    border: 1px solid var(--on-red-border);
    font-family: var(--font-ui);
    font-size: var(--ui-eyebrow-sm);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  /* ---- header ---- */
  .header {
    border-block-end: 1px solid var(--ink);
  }
  .row1 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    padding-block-start: 12px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    padding-block-end: 2px;
    font-size: var(--ui-control);
    color: var(--secondary);
    border-block-end: 2px solid transparent;
    text-decoration: none;
  }
  .nav__link:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .nav__link[aria-current='page'] {
    color: var(--ink);
    border-block-end-color: var(--red);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 160px;
    min-height: var(--control-h);
    padding: 0 10px;
    border: 1px solid var(--rule-strong);
    color: var(--muted);
  }
  .search__input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: var(--ui-control);
    color: var(--ink);
  }
  .search__input::placeholder {
    color: var(--muted);
  }

  /* ---- phone chrome: hamburger at start, search at end, drawer from the start edge ---- */
  .mobile {
    display: none;
  }

  /* Icon buttons read as buttons: the same 1px bordered square as the reader
     and language controls beside them; black fill while their panel is open. */
  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    transition: background-color 120ms ease-out, border-color 120ms ease-out, color 120ms ease-out;
  }
  @media (hover: hover) {
    .iconbtn:hover {
      border-color: var(--ink);
    }
  }
  .iconbtn:active,
  .iconbtn[aria-expanded='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-red);
  }

  /* expandable search row under the icon row */
  .msearch {
    flex-basis: 100%;
    display: flex;
    gap: 8px;
    padding-block: 10px 12px;
    border-block-start: 1px solid var(--rule);
  }
  .msearch[hidden] {
    display: none; /* author display beats the UA [hidden] rule — restate it */
  }
  .msearch__input {
    flex: 1;
    min-width: 0;
    min-height: var(--touch);
    padding: 0 12px;
    border: 1px solid var(--rule-strong);
    background: var(--surface);
    font-size: var(--ui-input-touch); /* ≥16px: iOS does not zoom the page on focus */
    color: var(--ink);
  }
  .msearch__input::placeholder {
    color: var(--muted);
  }
  .msearch__input:focus {
    outline: none;
    border-color: var(--ink);
  }
  .msearch__submit {
    min-height: var(--touch);
    padding: 0 16px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--on-red);
    font-size: var(--ui-nav);
  }

  /* ---- drawer ---- */
  .drawer {
    --drawer-hide: 100%; /* RTL: start edge is the right; slide out rightwards */
    position: fixed;
    inset: 0 auto 0 auto;
    inset-inline-start: 0;
    margin: 0;
    width: min(320px, 86vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    border-inline-end: 1px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    /* Closed = display:none, so nothing inside is reachable by Tab. The
       allow-discrete transition keeps it rendered until the slide-out ends. */
    display: none;
    flex-direction: column;
    overscroll-behavior: contain;
    translate: var(--drawer-hide) 0;
    opacity: 0;
    transition:
      translate 320ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 200ms ease-out,
      display 320ms allow-discrete,
      overlay 320ms allow-discrete;
  }
  :global(html[dir='ltr']) .drawer {
    --drawer-hide: -100%;
  }
  .drawer[open] {
    display: flex;
    translate: 0 0;
    opacity: 1;
  }
  @starting-style {
    .drawer[open] {
      translate: var(--drawer-hide) 0;
      opacity: 0;
    }
  }
  .drawer::backdrop {
    background: rgba(17, 17, 17, 0);
    transition:
      background-color 320ms ease-out,
      display 320ms allow-discrete,
      overlay 320ms allow-discrete;
  }
  .drawer[open]::backdrop {
    background: rgba(17, 17, 17, 0.55);
  }
  @starting-style {
    .drawer[open]::backdrop {
      background: rgba(17, 17, 17, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer::backdrop {
      transition: none;
    }
  }
  :global(html.drawer-open) {
    overflow: hidden;
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px var(--gutter);
    border-block-end: 1px solid var(--ink);
  }
  .drawer__logo {
    display: block;
    width: 150px;
  }
  .drawer__logo img {
    width: 100%;
    height: auto;
  }
  .drawer__nav {
    display: flex;
    flex-direction: column;
    padding: 8px var(--gutter) 0;
  }
  .drawer__link {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-size: var(--ui-drawer-link);
    font-weight: 700;
    color: var(--ink);
    border-block-end: 1px solid var(--hairline);
    text-decoration: none;
  }
  .drawer__link[aria-current='page'] {
    color: var(--red);
  }
  .drawer__tools {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px var(--gutter) 0;
  }
  /* stretch the bordered control groups to the drawer's width */
  .drawer__tools :global(.drawer__wide) {
    display: flex;
    width: 100%;
  }
  .drawer__tools :global(.drawer__wide > *) {
    flex: 1;
    justify-content: center;
  }
  .drawer__foot {
    margin-block-start: auto;
    padding: 18px var(--gutter) calc(18px + env(safe-area-inset-bottom));
    font-family: var(--font-nastaliq);
    line-height: 2;
    font-size: var(--ui-meta);
    color: var(--muted);
    border-block-start: 1px solid var(--rule);
  }

  @media (max-width: 767px) {
    .nav,
    .tools {
      display: none;
    }
    .mobile {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    /* All three stay on phones, smaller: group 11px · badge 9px · tagline 10px. */
    .strip__row {
      gap: 10px;
      padding-block: 5px;
    }
    .strip__group {
      font-size: var(--ui-eyebrow);
      line-height: 2;
      white-space: nowrap;
    }
    .strip__tagline {
      font-size: var(--ui-eyebrow-sm);
      line-height: 2;
      white-space: nowrap;
    }
    .strip__abc {
      padding: 2px 5px;
      font-size: var(--ui-badge-sm);
      letter-spacing: 0.1em;
    }

  }

  /* Narrow phones (≤379px): the three strip items no longer fit one row —
     texts share the first row, badge takes the second, still centred. */
  @media (max-width: 379px) {
    .strip__row {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'group tagline'
        'badge badge';
      row-gap: 2px;
    }
    .strip__group { grid-area: group; }
    .strip__tagline { grid-area: tagline; }
    .strip__abc { grid-area: badge; }
  }

  /* ---- masthead: rule 01, the wordmark is the image. Flag at start, globe at end. ---- */
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 6px 0 6px;
  }
  .masthead__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    text-align: center;
  }
  .masthead__emblem {
    display: block;
  }
  .masthead__emblem img {
    height: 100%;
    width: auto;
  }
  .masthead__emblem--flag {
    justify-self: start;
    height: var(--masthead-flag);
  }
  .masthead__emblem--globe {
    justify-self: end;
    height: var(--masthead-globe);
  }
  .masthead__kicker {
    font-size: var(--ui-search);
    color: var(--red);
  }
  .masthead__logo {
    display: block;
    width: 100%;
    max-width: clamp(250px, 30vw, var(--wordmark-desktop));
  }
  .masthead__logo img {
    width: 100%;
    height: auto;
  }
  .masthead__latin {
    padding-block-start: 6px;
    font-family: var(--font-ui);
    font-size: var(--ui-wordmark-sub);
    letter-spacing: var(--track-wordmark);
    color: var(--muted);
  }

  /* ---- dateline ---- */
  .dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 22px;
    padding: 9px 0 10px;
    border-block-start: 1px solid var(--rule);
    font-size: var(--ui-meta);
    color: var(--secondary);
  }
  .dateline__start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
  }
  .dateline__date {
    font-weight: 600;
    color: var(--ink);
  }
  .dateline__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
  }
  .dateline__dot {
    color: var(--rule-strong);
  }

  /* Phone overrides for the masthead and dateline. Kept LAST so they win the
     cascade over the base rules above (same specificity, later source). */
  @media (max-width: 767px) {
    /* wordmark alone — no room to flank it; the emblems fetch a 1px pixel */
    .masthead {
      grid-template-columns: 1fr;
    }
    .masthead__emblem {
      display: none;
    }
    /* centred, one item per line as in the phone mockup */
    .dateline,
    .dateline__start,
    .dateline__end {
      justify-content: center;
      text-align: center;
    }
  }
</style>
