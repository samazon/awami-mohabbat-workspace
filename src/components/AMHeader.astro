---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-awami-mohabbat.png';
import { t, type Locale } from '@/i18n';
import { formatFileSize, todayIso, isoToDate } from '@/lib/dates';
import { nav as navFor } from '@/lib/links';
import Icon from './Icon.astro';
import LtrRun from './LtrRun.astro';
import ReaderControls from './ReaderControls.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  active?: 'home' | 'archive' | 'columns' | 'gallery' | 'media-forum' | 'magazine' | 'team' | 'articles' | 'about' | 'contact';
  /** Today's edition, when the page has one: powers the e-paper button and card. */
  epaper?: { href: string; pages: number; pdfUrl: string | null; pdfBytes: number | null } | null;
}
const { locale, active = 'home', epaper = null } = Astro.props;
const s = t(locale);
const links = navFor(locale);
const pathname = Astro.url.pathname;

/** Search points at the (stub) search page until results exist. */
const SHOW_SEARCH = true;
const SHOW_TAGLINE_ROW = false;

type NavLink = { key: string; href: string; label: string };
type NavItem = NavLink | { key: string; label: string; children: NavLink[] };

// "Today's paper" is the front page, so it never claims aria-current (Home does).
const items: NavItem[] = [
  { key: 'home', href: links.home, label: s.nav.home },
  { key: 'columns', href: links.columns, label: s.nav.columns },
  {
    key: 'paper',
    label: s.nav.paper,
    children: [
      { key: 'today', href: links.home, label: s.nav.paperToday },
      { key: 'archive', href: links.archive, label: s.nav.paperPast },
    ],
  },
  { key: 'gallery', href: links.gallery, label: s.nav.gallery },
  { key: 'media-forum', href: links.mediaForum, label: s.nav.mediaForum },
  { key: 'magazine', href: links.magazine, label: s.nav.magazine },
  { key: 'about', href: links.about, label: s.nav.about },
  { key: 'team', href: links.team, label: s.nav.team },
  { key: 'contact', href: links.contact, label: s.contact.title },
];
const current = (key: string) => (key === active ? 'page' : undefined);
const groupHasActive = (i: NavItem) => 'children' in i && i.children.some((c) => c.key === active);

// Today, in the paper's home time zone, localised; the inline script swaps in
// the visitor's own local date (the page is edge-cached and shared).
const dateLocale = locale === 'ur' ? 'ur-PK' : 'en-GB';
const todayText = new Intl.DateTimeFormat(dateLocale, { timeZone: 'Asia/Karachi', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(isoToDate(todayIso()));

const epaperHref = epaper?.href ?? `${links.home}#today`;

/** Transparent 1×1 GIF: what phones fetch instead of the masthead emblems. */
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

{/* ---- utility strip: date · ABC (start) · text size · language · e-paper (end) ---- */}
<div class="strip">
  <div class="container strip__row">
    <div class="strip__group">
      <span class="pill pill--date" id="masthead-date" data-locale={dateLocale}>
        <Icon name="calendar" size="sm" />
        <span class="pill__text">{todayText}</span>
      </span>
    </div>
    <LtrRun class="pill pill--abc">{s.strip.abc}</LtrRun>
    <div class="strip__group strip__group--end">
      <ReaderControls locale={locale} variant="dark" />
      <LanguageSwitcher locale={locale} pathname={pathname} variant="dark" />
      <a class="epaper-btn" href={epaperHref} data-viewer-open={epaper ? '' : undefined}>
        <Icon name="newspaper" size="sm" />
        <span>{s.masthead.epaper}</span>
      </a>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var el = document.getElementById('masthead-date');
    var txt = el && el.querySelector('.pill__text');
    if (!txt || !window.Intl || !Intl.DateTimeFormat) return;
    try {
      txt.textContent = new Intl.DateTimeFormat(el.getAttribute('data-locale') || 'en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
    } catch (e) {}
  })();
</script>

<header class="header">
  {/* ---- second row: the two taglines — off for now, decide later ---- */}
  {SHOW_TAGLINE_ROW && (
  <div class="container subrow">
    <span class="subrow__item subrow__item--lead"><span class="dot" aria-hidden="true"></span>{s.footer.tagline}</span>
    <span class="subrow__item">{s.strip.tagline}</span>
  </div>
  )}

  {/* ---- masthead: group name + flag | wordmark | globe + e-paper card ---- */}
  <div class="container masthead">
    <div class="side side--start">
      <picture class="emblem emblem--flag">
        <source srcset={PIXEL} media="(max-width: 767px)" />
        <source srcset="/img/flag-pk-static.webp" media="(prefers-reduced-motion: reduce)" type="image/webp" />
        <img src="/img/flag-pk.webp" alt="" width="220" height="147" loading="eager" decoding="async" />
      </picture>
      <div class="side__text">
        <LtrRun block class="eyebrow side__eyebrow">{s.masthead.groupEyebrow}</LtrRun>
        <p class="side__title">{s.strip.group}</p>
      </div>
    </div>

    <div class="center">
      <span class="kicker"><span class="kicker__rule" aria-hidden="true"></span><span class="kicker__text">{s.masthead.daily}</span><span class="kicker__rule" aria-hidden="true"></span></span>
      <a class="logo" href={links.home} aria-label={s.meta.siteName}>
        <Image src={logo} alt={s.meta.siteName} widths={[250, 340, 500, 680]} sizes="(max-width: 767px) 250px, 340px" format="webp" loading="eager" fetchpriority="high" />
      </a>
      <LtrRun class="lockup">{s.masthead.lockup}</LtrRun>
      <LtrRun class="subline">{s.masthead.subline}</LtrRun>
    </div>

    <div class="side side--end">
      <div class="side__text side__text--end">
        {epaper ? (
          <a class="epaper-card" href={epaper.href} data-viewer-open>
            <span class="epaper-card__title">{s.masthead.epaperTitle} <span class="epaper-card__pages">({s.masthead.epaperPages(epaper.pages)})</span></span>
            {epaper.pdfBytes && <LtrRun class="epaper-card__size">{formatFileSize(epaper.pdfBytes)}</LtrRun>}
          </a>
        ) : (
          <a class="epaper-card" href={epaperHref}>
            <span class="epaper-card__title">{s.masthead.epaperTitle}</span>
          </a>
        )}
        <span class="side__hint">{s.masthead.epaperHint}</span>
      </div>
      <picture class="emblem emblem--globe">
        <source srcset={PIXEL} media="(max-width: 767px)" />
        <source srcset="/img/globe-static.webp" media="(prefers-reduced-motion: reduce)" type="image/webp" />
        <img src="/img/globe.webp" alt="" width="200" height="200" loading="eager" decoding="async" />
      </picture>
    </div>
  </div>

  {/* ---- navigation band ---- */}
  <div class="navbar">
    <div class="container navbar__row">
      <nav class="nav" aria-label={s.a11y.mainNav}>
        {items.map((i) =>
          'children' in i ? (
            <am-nav-menu class="nav__group">
              <button type="button" class="nav__link nav__toggle" aria-expanded="false" aria-controls={`nav-menu-${i.key}`} data-current={groupHasActive(i) ? '' : undefined}>
                {i.label}
                <Icon name="chevron-down" size="sm" />
              </button>
              <ul class="nav__menu" id={`nav-menu-${i.key}`}>
                {i.children.map((c) => (
                  <li><a class="nav__sublink" href={c.href} aria-current={current(c.key)}>{c.label}</a></li>
                ))}
              </ul>
            </am-nav-menu>
          ) : (
            <a class="nav__link" href={i.href} aria-current={current(i.key)}>{i.label}</a>
          ),
        )}
      </nav>

      {SHOW_SEARCH && (
        <form class="search" role="search" action={links.search} method="get">
          <label class="visually-hidden" for="q">{s.search.label}</label>
          <Icon name="search" size="md" />
          <input id="q" class="search__input" type="search" name="q" placeholder={s.search.placeholder} autocomplete="off" />
        </form>
      )}

      <am-mobile-nav class="mobile">
        <button type="button" class="iconbtn" data-menu aria-expanded="false" aria-controls="mobile-drawer" aria-label={s.nav.menu}>
          <Icon name="menu" size="lg" />
        </button>
        <dialog id="mobile-drawer" class="drawer" aria-label={s.nav.menu}>
          <div class="drawer__head">
            <a class="drawer__logo" href={links.home} aria-label={s.meta.siteName}>
              <Image src={logo} alt="" widths={[150, 300]} sizes="150px" format="webp" loading="lazy" />
            </a>
            <button type="button" class="iconbtn" data-close aria-label={s.nav.close} autofocus>
              <Icon name="x" size="lg" />
            </button>
          </div>
          <nav class="drawer__nav" aria-label={s.a11y.mainNav}>
            {items.map((i) =>
              'children' in i ? (
                <div class="drawer__group" role="group" aria-labelledby={`drawer-group-${i.key}`}>
                  <span class="drawer__link drawer__heading" id={`drawer-group-${i.key}`}>{i.label}</span>
                  {i.children.map((c) => (
                    <a class="drawer__link drawer__sublink" href={c.href} aria-current={current(c.key)}>{c.label}</a>
                  ))}
                </div>
              ) : (
                <a class="drawer__link" href={i.href} aria-current={current(i.key)}>{i.label}</a>
              ),
            )}
          </nav>
          <div class="drawer__tools">
            <LanguageSwitcher locale={locale} pathname={pathname} class="drawer__wide" />
            <ReaderControls locale={locale} class="drawer__wide" />
          </div>
          <p class="drawer__foot">{s.strip.tagline}</p>
        </dialog>
      </am-mobile-nav>
    </div>
  </div>
</header>

<script>
  /**
   * Phone chrome: a <dialog> drawer (native focus trap, Escape, top layer) and
   * an expandable search row. Both buttons reflect state via aria-expanded.
   */
  class MobileNav extends HTMLElement {
    connectedCallback() {
      const menuBtn = this.querySelector<HTMLButtonElement>('[data-menu]');
      const drawer = this.querySelector<HTMLDialogElement>('dialog.drawer');
      const closeBtn = drawer?.querySelector<HTMLButtonElement>('[data-close]');
      const searchBtn = this.querySelector<HTMLButtonElement>('[data-search-toggle]');
      const searchRow = this.querySelector<HTMLFormElement>('[data-search-row]');
      const searchInput = searchRow?.querySelector<HTMLInputElement>('input');
      if (!menuBtn || !drawer || !closeBtn) return;

      const root = document.documentElement;

      const openDrawer = () => {
        if (drawer.open) return;
        drawer.showModal();
        menuBtn.setAttribute('aria-expanded', 'true');
        root.classList.add('drawer-open');
      };
      const closeDrawer = () => {
        if (drawer.open) drawer.close();
      };
      menuBtn.addEventListener('click', openDrawer);
      closeBtn.addEventListener('click', closeDrawer);
      // Native `close` fires for Escape, close(), and form method=dialog alike.
      drawer.addEventListener('close', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        root.classList.remove('drawer-open');
        menuBtn.focus();
      });
      // A tap on the backdrop lands on the dialog element itself.
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) closeDrawer();
      });

      if (searchBtn && searchRow && searchInput) {
        const setSearch = (open: boolean) => {
          searchRow.hidden = !open;
          searchBtn.setAttribute('aria-expanded', String(open));
          if (open) searchInput.focus();
        };
        searchBtn.addEventListener('click', () => setSearch(searchRow.hasAttribute('hidden')));
        searchRow.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            setSearch(false);
            searchBtn.focus();
          }
        });
      }
    }
  }
  if (!customElements.get('am-mobile-nav')) customElements.define('am-mobile-nav', MobileNav);

  /**
   * Desktop dropdown. Hover opens it via CSS (mouse only); the button toggles it
   * for touch and keyboard. Escape, a click elsewhere, or focus leaving the
   * group closes it.
   */
  class NavMenu extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('.nav__toggle');
      if (!toggle) return;
      const set = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));

      toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
      this.addEventListener('mouseleave', () => set(false));
      this.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          set(false);
          toggle.focus();
        }
      });
      this.addEventListener('focusout', (e) => {
        if (!this.contains(e.relatedTarget as Node | null)) set(false);
      });
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) set(false);
      });
    }
  }
  if (!customElements.get('am-nav-menu')) customElements.define('am-nav-menu', NavMenu);
</script>

<style>
  /* ================= utility strip ================= */
  .strip {
    background: var(--strip-bg);
    color: var(--on-red);
  }
  /* 1fr auto 1fr: the badge sits dead-centre on the strip regardless of how
     wide the date and the controls are. */
  .strip__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 6px 12px;
    padding-block: 5px;
  }
  .strip__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-self: start;
    gap: 8px 12px;
  }
  .strip__group--end {
    justify-self: end;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 30px;
    padding: 0 12px;
    border: 1px solid var(--strip-pill-border);
    border-radius: var(--radius-pill);
    background: var(--strip-pill);
    font-family: var(--font-ui-mixed);
    font-size: var(--ui-control);
    line-height: 1.5;
    color: var(--on-red);
    font-variant-numeric: tabular-nums;
  }
  :global(html[lang='en']) .pill {
    font-family: var(--font-ui);
  }
  .pill--date svg {
    width: 13px;
    height: 13px;
    flex: none;
    opacity: 0.85;
  }
  .pill--abc {
    justify-self: center;
    font-family: var(--font-ui);
    font-size: var(--ui-eyebrow-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--on-red);
    border-color: var(--on-red);
  }
  .epaper-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 30px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    background: var(--gold);
    color: #2a1a00;
    font-family: var(--font-naskh);
    font-size: var(--ui-control);
    font-weight: 700;
    line-height: 1.6;
    text-decoration: none;
    transition: background-color 120ms ease-out;
  }
  :global(html[lang='en']) .epaper-btn {
    font-family: var(--font-ui);
  }
  .epaper-btn:hover {
    background: #e6c15e;
    color: #2a1a00;
    text-decoration: none;
  }

  /* ================= second row ================= */
  .subrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 24px;
    padding-block: 10px;
    border-block-end: 1px solid var(--rule);
    font-family: var(--font-body);
    font-size: var(--ui-nav);
    line-height: var(--lh-body);
    color: var(--body);
  }
  :global(html[lang='en']) .subrow {
    font-family: var(--font-serif);
    line-height: 1.5;
  }
  .subrow__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--strip-bg);
  }

  /* ================= masthead ================= */
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 16px 0 18px;
  }
  .side {
    display: flex;
    align-items: center;
    gap: 22px;
    min-width: 0;
  }
  .side--start {
    justify-self: start;
  }
  .side--end {
    justify-self: end;
  }
  .emblem {
    display: block;
    flex: none;
  }
  .emblem img {
    height: 100%;
    width: auto;
  }
  .emblem--flag {
    height: var(--masthead-flag);
  }
  .emblem--globe {
    height: var(--masthead-globe);
  }
  .side__text {
    min-width: 0;
  }
  .side__text--end {
    text-align: end;
  }
  .side__eyebrow {
    font-size: var(--ui-eyebrow-sm);
    letter-spacing: 0.18em;
    color: var(--muted);
  }
  /* localized hint → label face; never the Latin eyebrow treatment */
  .side__hint {
    display: block;
    margin-block-start: 6px;
    font-family: var(--font-label);
    line-height: var(--lh-label);
    font-size: var(--ui-eyebrow);
    color: var(--muted);
  }
  .side__title {
    margin-block-start: 6px;
    font-family: var(--font-naskh);
    font-size: var(--fs-section);
    font-weight: 600;
    line-height: 1.7;
    color: var(--ink);
  }
  :global(html[lang='en']) .side__title {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.3;
  }

  .epaper-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 48px;
    padding: 8px 14px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--tint);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 120ms ease-out;
  }
  .epaper-card:hover {
    border-color: var(--ink);
    color: var(--ink);
    text-decoration: none;
  }
  .epaper-card__title {
    font-family: var(--font-naskh);
    font-size: var(--ui-nav);
    line-height: 1.7;
  }
  :global(html[lang='en']) .epaper-card__title {
    font-family: var(--font-ui);
  }
  .epaper-card__pages {
    color: var(--secondary);
  }
  .epaper-card__size {
    flex: none;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--strip-bg);
    color: var(--on-red);
    font-family: var(--font-ui);
    font-size: var(--ui-eyebrow);
    font-weight: 600;
  }

  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--strip-bg);
  }
  .kicker__rule {
    width: 110px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  .kicker__text {
    font-family: var(--font-label);
    line-height: var(--lh-label);
    font-size: var(--ui-search);
  }
  .logo {
    display: block;
    width: 100%;
    max-width: clamp(250px, 30vw, var(--wordmark-desktop));
  }
  .logo img {
    width: 100%;
    height: auto;
  }
  .lockup {
    margin-block-start: 2px;
    font-family: var(--font-serif);
    font-size: var(--ui-nav);
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--red-deep);
  }
  .subline {
    margin-block-start: 6px;
    font-family: var(--font-ui);
    font-size: var(--ui-meta);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  /* ================= navigation band ================= */
  .navbar {
    background: var(--nav-bg);
    color: var(--on-dark);
    border-block-end: 3px solid var(--strip-bg);
  }
  .navbar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  /* Wraps rather than scrolls: a scroll container would clip the dropdown. */
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    min-width: 0;
    padding-block: 10px;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: var(--radius-sm);
    font-family: var(--font-naskh);
    font-size: var(--ui-nav);
    font-weight: 600;
    line-height: 1.6;
    color: var(--on-dark);
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 120ms ease-out;
  }
  :global(html[lang='en']) .nav__link {
    font-family: var(--font-ui);
  }
  .nav__link:hover {
    background: var(--nav-bg-elev);
    color: var(--on-dark);
    text-decoration: none;
  }
  .nav__link[aria-current='page'],
  .nav__toggle[data-current] {
    background: var(--red);
    color: var(--on-red);
  }

  /* ---- dropdown ---- */
  .nav__group {
    position: relative;
    display: inline-flex;
  }
  .nav__toggle {
    gap: 6px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .nav__toggle :global(svg) {
    transition: rotate 160ms ease-out;
  }
  .nav__toggle[aria-expanded='true'] :global(svg) {
    rotate: 180deg;
  }
  .nav__menu {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 0;
    z-index: 20;
    display: none;
    min-width: 200px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: var(--radius-sm);
    border-block-start: 3px solid var(--strip-bg);
    background: var(--nav-bg);
    box-shadow: 0 10px 24px rgba(17, 17, 17, 0.28);
  }
  /* A strip of padding above the menu bridges the pointer from button to menu. */
  .nav__menu::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    height: 8px;
  }
  .nav__toggle[aria-expanded='true'] + .nav__menu {
    display: block;
  }
  @media (hover: hover) {
    .nav__group:hover .nav__menu {
      display: block;
    }
  }
  .nav__sublink {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-naskh);
    font-size: var(--ui-nav);
    font-weight: 600;
    line-height: 1.6;
    color: var(--on-dark);
    white-space: nowrap;
    text-decoration: none;
  }
