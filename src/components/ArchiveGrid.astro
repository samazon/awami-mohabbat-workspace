---
/** Homepage "recent editions" strip. */
import { localePath, t, type Locale } from '@/i18n';
import type { EditionCard } from '@/lib/services/editions';
import ArchiveCards from './ArchiveCards.astro';

interface Props {
  editions: EditionCard[];
  locale: Locale;
}
const { editions, locale } = Astro.props;
const s = t(locale);
const arrow = locale === 'ur' ? '←' : '→';
---

{editions.length > 0 && (
  <section id="archive" class="section">
    <div class="container">
      <header class="section-head">
        <h2 class="section-title">{s.archive.title}</h2>
        <a class="all t-label" href={localePath(locale, '/archive')}>{s.archive.viewAll} {arrow}</a>
      </header>
      <ArchiveCards editions={editions} locale={locale} />
    </div>
  </section>
)}

<style>
  .t-label {
    font-family: var(--font-label);
    line-height: var(--lh-label);
  }
  .all {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-size: var(--ui-nav);
  }
</style>
