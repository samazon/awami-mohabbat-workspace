---
/** Plain links — switching language keeps the reader on the same page. */
import { LOCALES, localePath, neutralPath, t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  pathname: string;
  class?: string;
  /** `dark`: white-outlined pill for the red strip; active segment is white. */
  variant?: 'light' | 'dark';
}
const { locale, pathname, class: className, variant = 'light' } = Astro.props;
const s = t(locale);
const route = neutralPath(pathname);
---

<nav class:list={['lang', `lang--${variant}`, className]} aria-label={s.lang.group}>
  {LOCALES.map((l) => (
    <a
      class="lang__link"
      href={localePath(l, route)}
      lang={l}
      dir={l === 'ur' ? 'rtl' : 'ltr'}
      hreflang={l}
      aria-current={l === locale ? 'page' : undefined}
    >{s.lang[l]}</a>
  ))}
</nav>

<style>
  .lang {
    display: inline-flex;
    border: 1px solid var(--rule-strong);
  }
  .lang__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    padding: 0 10px;
    font-family: var(--font-ui);
    font-size: var(--ui-control);
    color: var(--secondary);
    text-decoration: none;
    border-inline-end: 1px solid var(--rule-strong);
  }
  .lang__link[lang='ur'] {
    font-family: var(--font-nastaliq);
    line-height: 1.9;
  }
  .lang__link:last-child {
    border-inline-end: 0;
  }
  .lang__link:hover {
    color: var(--red);
    text-decoration: none;
  }
  .lang__link[aria-current='page'] {
    background: var(--ink);
    color: var(--on-red);
  }

  /* dark pill (strip) */
  .lang.lang--dark {
    border: 1px solid var(--strip-pill-border);
    border-radius: var(--radius-pill);
    padding: 2px;
    gap: 2px;
    background: var(--strip-pill);
  }
  .lang.lang--dark .lang__link,
  .lang.lang--dark .lang__link:last-child {
    min-height: 26px;
    padding: 0 10px;
    border: 0;
    font-size: var(--ui-control);
    border-radius: var(--radius-pill);
    color: var(--on-red);
  }
  .lang.lang--dark .lang__link:hover {
    color: var(--on-red);
    background: rgba(255, 255, 255, 0.12);
  }
  .lang.lang--dark .lang__link[aria-current='page'] {
    background: var(--on-red);
    color: var(--strip-bg);
  }
</style>
