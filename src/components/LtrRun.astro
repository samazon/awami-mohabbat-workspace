---
/**
 * Rule 03: isolate every Latin or numeral run inside RTL text.
 * Dates, prices, phone numbers, volume lines, the Latin lockup, the ABC badge.
 *
 * `block` — the run is its own line; also pin text-align to the page's start
 * edge so the isolated LTR run doesn't drift against the RTL flow.
 * `tabular` — numerals line up (ticker, rates, phone numbers).
 *
 * Parents style this element through `class`. Astro hands the parent's scope
 * attribute over in `Astro.props`, so the rest props are spread onto the
 * element — without that, parent-scoped rules never match.
 */
interface Props {
  block?: boolean;
  tabular?: boolean;
  class?: string;
  title?: string;
  id?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}
const { block = false, tabular = false, class: className, title, id, ...rest } = Astro.props;
const Tag = block ? 'div' : 'span';
---
<Tag {...rest} id={id} dir="ltr" class:list={['ltr', { tabular, 'ltr--block': block }, className]} title={title}><slot /></Tag>

<style>
  /* `text-align: start` on a dir="ltr" box resolves to LEFT — the opposite of
     the page's start edge in Urdu. Pin it to the page direction explicitly. */
  .ltr--block {
    display: block;
    text-align: left;
  }
  :global(html[dir='rtl']) .ltr--block {
    text-align: right;
  }
</style>
