---
/**
 * /columns: heading, columnist filter, 12-up grid, pagination. State is in the
 * URL (?columnist=&page=), so every view works without JS and can be linked and cached.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath, t, type Locale } from '@/i18n';
import type { ColumnsState } from '@/lib/columns-route';
import { getSiteConfig } from '@/lib/services/config';
import AMFooter from './AMFooter.astro';
import AMHeader from './AMHeader.astro';
import ColumnGrid from './ColumnGrid.astro';
import Pagination from './Pagination.astro';

interface Props extends ColumnsState {
  locale: Locale;
}
const { locale, page, columnist, filters, result } = Astro.props;
const s = t(locale);
const config = await getSiteConfig(locale);

const base = localePath(locale, '/columns');
const href = (who: string | null, p = 1) => {
  const q = new URLSearchParams();
  if (who) q.set('columnist', who);
  if (p > 1) q.set('page', String(p));
  const qs = q.toString();
  return qs ? `${base}?${qs}` : base;
};
const from = result.total === 0 ? 0 : (page - 1) * result.perPage + 1;
const to = Math.min(result.total, page * result.perPage);
const title = page > 1 ? `${s.columns.title} (${page}) — ${s.meta.siteName}` : `${s.columns.title} — ${s.meta.siteName}`;
---

<BaseLayout title={title} description={s.columns.description}>
  <AMHeader slot="header" locale={locale} active="columns" />

  <div class="container">
    <header class="head">
      <h1 class="title t-head">{s.columns.title}</h1>
      <p class="sub">{s.columns.subtitle}</p>
    </header>

    {filters.length > 1 && (
      <nav class="filter" aria-label={s.columns.filterLabel}>
        <div class="chips">
          <a class="chip" href={href(null)} aria-current={columnist === null ? 'true' : undefined}>{s.columns.all}</a>
          {filters.map((f) => (
            <a class="chip" href={href(f.slug)} lang={f.nameLang} aria-current={columnist === f.slug ? 'true' : undefined}>{f.name}</a>
          ))}
        </div>
      </nav>
    )}

    {result.items.length > 0 ? (
      <div class="list"><ColumnGrid columns={result.items} locale={locale} /></div>
    ) : (
      <p class="empty t-body">{s.columns.empty}</p>
    )}

    <Pagination
      page={page}
      pageCount={result.pageCount}
      href={(p) => href(columnist, p)}
      label={s.columns.pagination}
      prevLabel={s.columns.prevPage}
      nextLabel={s.columns.nextPage}
      meta={s.columns.showing(from, to, result.total)}
    />
  </div>

  <AMFooter slot="footer" locale={locale} config={config} />
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
    padding: 34px 0 14px;
    border-block-end: 1px solid var(--ink);
  }
  .title {
    font-size: var(--fs-h1);
  }
  .sub {
    font-family: var(--font-body);
    line-height: var(--lh-body);
    font-size: var(--fs-card);
    color: var(--secondary);
  }
  .filter {
    padding: 18px 0;
    border-block-end: 1px solid var(--rule);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-h);
    padding: 0 12px;
    border: 1px solid var(--ink);
    font-family: var(--font-ui-mixed);
    line-height: var(--lh-label);
    font-size: var(--ui-nav);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
  }
  /* Written as descendants: see the same note in ArchivePage.astro about Astro's scoping. */
  .chips .chip:hover {
    color: var(--red);
    border-color: var(--red);
    text-decoration: none;
  }
  .chips .chip[aria-current] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-red);
  }
  .list {
    padding-block-start: 24px;
  }
  .empty {
    padding: 30px 0 40px;
    font-size: var(--fs-body);
    color: var(--secondary);
  }
</style>
