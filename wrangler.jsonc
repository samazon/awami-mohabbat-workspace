{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awami-mohabbat",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // `main` and `assets` are set by @astrojs/cloudflare at build time.

  // Custom domains (Cloudflare manages DNS + TLS). www redirects to the apex
  // in src/middleware.ts. The workers.dev URL stays on as a preview.
  "routes": [
    { "pattern": "awamimohabbat.com", "custom_domain": true },
    { "pattern": "www.awamimohabbat.com", "custom_domain": true }
  ],
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "awami-mohabbat",
      "database_id": "b4dc1895-db94-40c7-8d7f-04c5a4324bb9",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "awami-mohabbat-media"
    }
  ],

  // "Join us" applications are emailed through Cloudflare Email Routing.
  // Every address in JOIN_NOTIFY_TO must be a verified destination address in
  // Email Routing for awamimohabbat.com, or Cloudflare refuses the send.
  "send_email": [{ "name": "JOIN_MAIL" }],

  "vars": {
    // Dev + first deploy: serve R2 objects through the Worker's /media route.
    // Once the R2 custom domain exists, set this to https://cdn.<domain>.
    "CDN_BASE": "/media",
    // Comma-separated inboxes for new "Join us" applications.
    "JOIN_NOTIFY_TO": "awami_mohabbat@yahoo.com,sommerbareen1@gmail.com",
    // Cloudflare Access for /admin (src/lib/admin/access.ts). Not secrets: the
    // application's audience tag and the Zero Trust team name. If either is
    // missing, /admin refuses everyone in production.
    "ACCESS_AUD": "bf86f11801703a11756959874bb6038a2c58fb2e9805c483252b08b375ccff39",
    "ACCESS_TEAM_DOMAIN": "damp-morning-0645"
  }
}
