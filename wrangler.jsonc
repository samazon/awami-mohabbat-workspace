{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awami-mohabbat",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // `main` and `assets` are set by @astrojs/cloudflare at build time.

  // Custom domains (Cloudflare manages DNS + TLS). www redirects to the apex
  // in src/middleware.ts. The workers.dev URL stays on as a preview.
  "routes": [
    { "pattern": "awamimohabbat.com", "custom_domain": true },
    { "pattern": "www.awamimohabbat.com", "custom_domain": true }
  ],
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "awami-mohabbat",
      "database_id": "b4dc1895-db94-40c7-8d7f-04c5a4324bb9",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "awami-mohabbat-media"
    }
  ],

  "vars": {
    // Dev + first deploy: serve R2 objects through the Worker's /media route.
    // Once the R2 custom domain exists, set this to https://cdn.<domain>.
    "CDN_BASE": "/media"
  }
}
