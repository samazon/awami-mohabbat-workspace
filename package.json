{
  "name": "awami-mohabbat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types": "wrangler types",
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "astro preview",
    "check": "wrangler types && astro check && tsc --noEmit -p tsconfig.scripts.json",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply awami-mohabbat --local",
    "db:migrate:remote": "wrangler d1 migrations apply awami-mohabbat --remote",
    "seed": "tsx scripts/seed.ts",
    "deploy": "wrangler types && astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/react": "^6.0.6",
    "astro": "7.3.3",
    "astro-icon": "1.2.0",
    "drizzle-orm": "0.45.3",
    "photoswipe": "^5.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/lucide": "^1.2.136",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "postcss-html": "^2.0.0",
    "sharp": "0.35.4",
    "stylelint": "17.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "4.136.2",
    "zod": "^4.6.5"
  }
}
