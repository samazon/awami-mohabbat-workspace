{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "scripts"
  ]
}
